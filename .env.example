# Frontend-safe Supabase values (never put the service role key in VITE_* variables)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-side only; configure in your hosting provider's environment settings
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret
PAYSTACK_CALLBACK_URL=https://your-domain.example/payment/callback
